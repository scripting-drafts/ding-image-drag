"""Borderless image canvas.

Display an image in an undecorated window. Ctrl+W (or Esc) closes it;
left-drag anywhere on the image moves the window.
"""
from __future__ import annotations

import argparse
import ctypes
import sys
from pathlib import Path

import gi

gi.require_version("Gtk", "4.0")
gi.require_version("Gdk", "4.0")
from gi.repository import Gdk, Gio, GLib, Gtk  # noqa: E402

try:
    gi.require_version("GdkX11", "4.0")
    from gi.repository import GdkX11  # noqa: E402
except (ImportError, ValueError):
    GdkX11 = None

APP_NAME = "image-canvas"
BUTTON1_MASK = 1 << 8

CSS = b"""
window.image-canvas {
    background-color: #000000;
}
"""


class X11WindowMover:
    """Move a toplevel window with X11 while the pointer is dragged."""

    def __init__(self, xid: int):
        self.xid = xid
        self.offset: tuple[int, int] | None = None
        self.display = None
        self._xlib = ctypes.CDLL("libX11.so.6")
        xlib = self._xlib
        xlib.XOpenDisplay.restype = ctypes.c_void_p
        xlib.XOpenDisplay.argtypes = [ctypes.c_char_p]
        xlib.XDefaultRootWindow.restype = ctypes.c_ulong
        xlib.XDefaultRootWindow.argtypes = [ctypes.c_void_p]
        xlib.XQueryPointer.restype = ctypes.c_int
        xlib.XQueryPointer.argtypes = [
            ctypes.c_void_p,
            ctypes.c_ulong,
            ctypes.POINTER(ctypes.c_ulong),
            ctypes.POINTER(ctypes.c_ulong),
            ctypes.POINTER(ctypes.c_int),
            ctypes.POINTER(ctypes.c_int),
            ctypes.POINTER(ctypes.c_int),
            ctypes.POINTER(ctypes.c_int),
            ctypes.POINTER(ctypes.c_uint),
        ]
        xlib.XTranslateCoordinates.restype = ctypes.c_int
        xlib.XTranslateCoordinates.argtypes = [
            ctypes.c_void_p,
            ctypes.c_ulong,
            ctypes.c_ulong,
            ctypes.c_int,
            ctypes.c_int,
            ctypes.POINTER(ctypes.c_int),
            ctypes.POINTER(ctypes.c_int),
            ctypes.POINTER(ctypes.c_ulong),
        ]
        xlib.XMoveWindow.restype = ctypes.c_int
        xlib.XMoveWindow.argtypes = [
            ctypes.c_void_p,
            ctypes.c_ulong,
            ctypes.c_int,
            ctypes.c_int,
        ]
        xlib.XFlush.argtypes = [ctypes.c_void_p]
        xlib.XCloseDisplay.argtypes = [ctypes.c_void_p]

        self.display = xlib.XOpenDisplay(None)
        if not self.display:
            raise OSError("cannot open X11 display")
        self.root = xlib.XDefaultRootWindow(self.display)

    def _pointer(self) -> tuple[int, int, int]:
        root_return = ctypes.c_ulong()
        child_return = ctypes.c_ulong()
        root_x = ctypes.c_int()
        root_y = ctypes.c_int()
        win_x = ctypes.c_int()
        win_y = ctypes.c_int()
        mask = ctypes.c_uint()
        self._xlib.XQueryPointer(
            self.display,
            self.root,
            ctypes.byref(root_return),
            ctypes.byref(child_return),
            ctypes.byref(root_x),
            ctypes.byref(root_y),
            ctypes.byref(win_x),
            ctypes.byref(win_y),
            ctypes.byref(mask),
        )
        return root_x.value, root_y.value, mask.value

    def start(self) -> bool:
        pointer_x, pointer_y, _mask = self._pointer()
        window_x = ctypes.c_int()
        window_y = ctypes.c_int()
        child = ctypes.c_ulong()
        self._xlib.XTranslateCoordinates(
            self.display,
            self.xid,
            self.root,
            0,
            0,
            ctypes.byref(window_x),
            ctypes.byref(window_y),
            ctypes.byref(child),
        )
        self.offset = (pointer_x - window_x.value, pointer_y - window_y.value)
        return True

    def move(self) -> None:
        if self.offset is None:
            return
        pointer_x, pointer_y, mask = self._pointer()
        if not mask & BUTTON1_MASK:
            return
        self._xlib.XMoveWindow(
            self.display,
            self.xid,
            pointer_x - self.offset[0],
            pointer_y - self.offset[1],
        )
        self._xlib.XFlush(self.display)

    def close(self) -> None:
        if self.display is not None:
            self._xlib.XCloseDisplay(self.display)
            self.display = None


def parse_args(argv: list[str]) -> argparse.Namespace:
    parser = argparse.ArgumentParser(
        prog=APP_NAME,
        description="Show an image in a borderless window.",
        epilog="Keys: Ctrl+W or Esc closes; left-drag moves the window.",
    )
    parser.add_argument("image", type=Path, help="image file to display")
    parser.add_argument(
        "-f", "--fullscreen", action="store_true", help="fill the monitor"
    )
    return parser.parse_args(argv)


def target_workarea(display: Gdk.Display) -> Gdk.Rectangle | None:
    """Return the work area of the monitor under the pointer."""
    monitors = display.get_monitors()
    if monitors.get_n_items() == 0:
        return None

    monitor = monitors.get_item(0)
    seat = display.get_default_seat()
    if seat is not None:
        pointer = seat.get_pointer()
        if pointer is not None:
            _surface, x, y = pointer.get_surface_at_position()
            for index in range(monitors.get_n_items()):
                candidate = monitors.get_item(index)
                geometry = candidate.get_geometry()
                if (
                    geometry.x <= x < geometry.x + geometry.width
                    and geometry.y <= y < geometry.y + geometry.height
                ):
                    monitor = candidate
                    break

    if hasattr(monitor, "get_workarea"):
        return monitor.get_workarea()
    return monitor.get_geometry()


def fit_to_monitor(
    display: Gdk.Display, width: int, height: int
) -> tuple[int, int]:
    """Shrink the window to the target monitor when needed."""
    workarea = target_workarea(display)
    if workarea is None:
        return width, height
    scale = min(1.0, workarea.width / width, workarea.height / height)
    return max(1, round(width * scale)), max(1, round(height * scale))


def build_window(
    app: Gtk.Application, texture: Gdk.Texture, path: Path, fullscreen: bool
) -> Gtk.Window:
    window = Gtk.ApplicationWindow(application=app, title=path.name)
    window.set_decorated(False)
    window.set_resizable(True)
    window.add_css_class("image-canvas")

    provider = Gtk.CssProvider()
    provider.load_from_data(CSS)
    Gtk.StyleContext.add_provider_for_display(
        window.get_display(), provider, Gtk.STYLE_PROVIDER_PRIORITY_APPLICATION
    )

    picture = Gtk.Picture.new_for_paintable(texture)
    picture.set_keep_aspect_ratio(True)
    picture.set_can_shrink(True)
    window.set_child(picture)

    if fullscreen:
        workarea = target_workarea(window.get_display())
        if workarea is not None:
            window.set_default_size(workarea.width, workarea.height)
        window.fullscreen()
    else:
        width, height = fit_to_monitor(
            window.get_display(), texture.get_width(), texture.get_height()
        )
        window.set_default_size(width, height)

    def close(_controller, keyval, _keycode, state):
        control = state & Gdk.ModifierType.CONTROL_MASK
        if keyval in (Gdk.KEY_w, Gdk.KEY_W) and control:
            window.close()
            return True
        if keyval == Gdk.KEY_Escape:
            window.close()
            return True
        return False

    keys = Gtk.EventControllerKey()
    keys.set_propagation_phase(Gtk.PropagationPhase.CAPTURE)
    keys.connect("key-pressed", close)
    window.add_controller(keys)

    if not fullscreen:
        mover: X11WindowMover | None = None

        def drag_begin(gesture, x, y):
            nonlocal mover
            if mover is not None:
                mover.close()
                mover = None
            surface = window.get_surface()
            if GdkX11 is not None and isinstance(surface, GdkX11.X11Surface):
                try:
                    mover = X11WindowMover(surface.get_xid())
                    mover.start()
                    return
                except OSError:
                    mover = None
            device = gesture.get_current_event_device()
            if surface is not None and device is not None:
                Gdk.Toplevel.begin_move(
                    surface, device, 1, int(x), int(y), gesture.get_current_event_time()
                )

        def drag_update(_gesture, _offset_x, _offset_y):
            if mover is not None:
                mover.move()

        def drag_end(_gesture, _offset_x, _offset_y):
            nonlocal mover
            if mover is not None:
                mover.close()
                mover = None

        drag = Gtk.GestureDrag()
        drag.set_propagation_phase(Gtk.PropagationPhase.CAPTURE)
        drag.connect("drag-begin", drag_begin)
        drag.connect("drag-update", drag_update)
        drag.connect("drag-end", drag_end)
        window.add_controller(drag)

    return window


class ImageCanvasApp(Gtk.Application):
    def __init__(self, texture: Gdk.Texture, path: Path, fullscreen: bool):
        super().__init__(application_id=None, flags=Gio.ApplicationFlags.NON_UNIQUE)
        self.texture = texture
        self.path = path
        self.fullscreen = fullscreen

    def do_activate(self) -> None:
        window = build_window(self, self.texture, self.path, self.fullscreen)
        window.present()


def main(argv: list[str]) -> int:
    GLib.set_prgname(APP_NAME)
    GLib.set_application_name("Image Canvas")
    args = parse_args(argv)
    path = args.image.expanduser()
    if not path.is_file():
        print(f"{APP_NAME}: not a file: {path}", file=sys.stderr)
        return 2

    try:
        texture = Gdk.Texture.new_from_filename(str(path))
    except GLib.Error as error:
        print(f"{APP_NAME}: cannot load {path}: {error.message}", file=sys.stderr)
        return 1

    return ImageCanvasApp(texture, path, args.fullscreen).run([])


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
